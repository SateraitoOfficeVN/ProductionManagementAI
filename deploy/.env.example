# Copy to deploy/.env and fill in real local values before running `docker compose up`.
# Never commit deploy/.env — .gitignore already excludes it.

POSTGRES_DB=production_management_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Password for the restricted runtime login `pmai_app` the backend uses (DEC-016). Required, no default: choose one.
# It is applied only when the db volume is first created; after changing it, wipe the volume
# (docker compose down -v) instead of syncing it by hand.
PMAI_APP_DB_PASSWORD=
# Plant timezone that defines "today" and the order-number year (DEC-017).
PLANT_TIMEZONE=Asia/Tokyo

# Seeds the Admin/Operator roles + one admin user on backend startup (Development only, no hardcoded fallback).
SEED_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8081
# 3000, not 8080: 8080 falls in Windows' reserved/excluded TCP port range on some machines (Hyper-V/WSL NAT).
FRONTEND_PORT=3000
# 5433, not 5432: avoids colliding with any Postgres already running on this machine outside this stack.
POSTGRES_PORT=5433
